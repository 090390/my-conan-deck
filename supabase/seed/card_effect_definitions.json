    {
      "effectId": "card-0636-on-enter-search-shinichi",
      "cardIds": [
        "0636"
      ],
      "cardNameKo": "모리 란",
      "cardNameJa": "毛利蘭",
      "trigger": {
        "event": "character.entered_field",
