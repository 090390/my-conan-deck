{
  "schemaVersion": 1,
  "language": "conan-card-effect-dsl",
  "definitions": [
    {
      "effectId": "card-0062-on-enter",
      "cardIds": [
        "0062"
      ],
      "cardNameKo": "조디 스털링",
      "cardNameJa": "ジョディ・スターリング",
      "trigger": {
        "event": "character.entered_field",
        "timing": "after"
      },
      "conditions": [],
      "steps": [
        {
          "op": "refill_deck_from_remove_area",
          "when": {
            "fact": "player.deck.count",
            "operator": "less_than",
            "value": 4
          },
          "includeRemainingDeck": true,
          "includeRemoveArea": true,
          "shuffle": true
        },
        {
          "op": "peek_top_cards",
          "count": 4,
          "allowFewer": true,
          "saveAs": "seen"
        },
        {
          "op": "select_cards",
          "from": "seen",
          "min": 0,
          "max": 1,
          "optional": true,
          "filter": {
            "field": "color",
            "operator": "equals",
            "value": "red"
          },
          "prompt": "공개하여 패에 넣을 적 카드를 최대 1장 선택하세요.",
          "saveAs": "selected_red"
        },
        {
          "op": "reveal_cards",
          "from": "selected_red",
          "to": [
            "opponent"
          ],
          "awaitAcknowledgement": true,
          "when": {
            "fact": "vars.selected_red.count",
            "operator": "greater_than",
            "value": 0
          }
        },
        {
          "op": "move_cards",
          "from": "selected_red",
          "to": "hand",
          "when": {
            "fact": "vars.selected_red.count",
            "operator": "greater_than",
            "value": 0
          }
        },
        {
          "op": "move_unselected_to_deck_bottom",
          "from": "seen",
          "selectedVariable": "selected_red",
          "order": "player_choice"
        },
        {
          "op": "select_cards",
          "from": "hand",
          "min": 1,
          "max": 1,
          "optional": false,
          "prompt": "패에 추가한 경우, 리무브할 손패 1장을 선택하세요.",
          "saveAs": "hand_to_remove",
          "when": {
            "fact": "vars.selected_red.count",
            "operator": "greater_than",
            "value": 0
          }
        },
        {
          "op": "move_cards",
          "from": "hand_to_remove",
          "to": "remove_area",
          "when": {
            "fact": "vars.selected_red.count",
            "operator": "greater_than",
            "value": 0
          }
        }
      ]
    },
