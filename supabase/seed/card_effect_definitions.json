        {
          "fact": "player.partner.color",
          "operator": "equals",
          "value": "blue"
        }
      ],
      "steps": [
        {
          "op": "reveal_until_match",
          "from": "deck",
          "saveAs": "search_result",
          "match": {
            "allOf": [
              {
                "field": "level",
                "operator": "greater_than_or_equal",
                "value": 7
              },
              {
                "field": "card_name",
                "operator": "name_matches",
                "value": "工藤新一"
              }
            ]
          },
          "includeMatchingCard": true,
          "publicReveal": true,
          "oneByOne": true,
          "awaitActorAcknowledgement": true,
          "whenNoMatch": "shuffle_all_back"
        },
        {
          "op": "move_cards",
          "from": "search_result.matched",
          "to": "hand",
          "when": {
            "fact": "vars.search_result.matched_count",
            "operator": "greater_than",
            "value": 0
          }
        },
        {
          "op": "move_unselected_to_zone",
          "from": "search_result.revealed",
          "selectedVariable": "search_result.matched",
          "to": "deck_bottom",
          "order": "preserve"
